# Every pinned version used by the pipeline. Sourced by run.sh and read by the
# workflow. Renovate bumps the lines that carry a "renovate:" comment.

# kubernetes-sigs/ai-conformance has no release tags yet; bump by hand.
SUITE_SHA=da952539a75be3ceee8bbf82698c5f19c401cb2d

# renovate: datasource=helm depName=gpu-operator registryUrl=https://helm.ngc.nvidia.com/nvidia
GPU_OPERATOR_VERSION=v26.7.0

# renovate: datasource=github-releases depName=kubernetes-sigs/kueue
KUEUE_VERSION=v0.18.2

# k0sctl 0.32+ fails on hosts with fs.protected_regular=1: k0sproject/k0sctl#1186
# renovate: datasource=github-releases depName=k0sproject/k0sctl
K0SCTL_VERSION=0.31.1

# renovate: datasource=github-releases depName=gotestyourself/gotestsum
GOTESTSUM_VERSION=v1.13.0
